# Copie este arquivo para .env e preencha com os valores reais.
# O .env nunca deve ser commitado (já está no .gitignore).

# O projeto usa DOIS bancos, sempre, com propósitos fixos (veja db/connection.py):
# - Postgres (config abaixo): SEMPRE usado para o estado do próprio sistema
#   (usuários, trilha de auditoria de login, histórico de relatórios, layouts,
#   cores de categoria) — independente do valor de DB_BACKEND.
# - Oracle/Postgres (config ORACLE_* + DB_BACKEND abaixo): dado de
#   negócio/RAG financeiro (views do Protheus) — "oracle" em produção,
#   "postgres" localmente (contra views de teste), se não tiver acesso ao
#   Oracle real.
DB_BACKEND=oracle

# Conexão com o Oracle (dado de negócio/RAG financeiro)
ORACLE_DSN=host:porta/service_name
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1
# Só necessário se o servidor Oracle exigir Native Network Encryption/Data
# Integrity (thin mode não suporta) — caminho do Oracle Instant Client.
ORACLE_CLIENT_LIB_DIR=

# Conexão com o Postgres — SEMPRE usada (estado do sistema), e também usada
# como dado de negócio/RAG quando DB_BACKEND=postgres (teste local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agente_oracle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Servidor MCP
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Origens (frontend) autorizadas a chamar a API pelo navegador, separadas por
# vírgula. Adicione aqui o domínio de produção quando fizer o deploy.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Ollama (opcional)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Modelo de embeddings pro RAG de candidatos do RH — precisa ser baixado à
# parte: `ollama pull nomic-embed-text`.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Autenticação (login próprio do sistema)
# Chave usada pra assinar o token de login — gere um valor aleatório único
# (ex: python -c "import secrets; print(secrets.token_hex(32))") e nunca
# reutilize entre ambientes. Trocar essa chave desloga todo mundo na hora.
AUTH_SECRET_KEY=
AUTH_TOKEN_HORAS=12
