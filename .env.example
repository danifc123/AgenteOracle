# Copie este arquivo para .env e preencha com os valores reais.
# O .env nunca deve ser commitado (já está no .gitignore).

# O projeto usa DOIS bancos, sempre, com propósitos fixos (veja db/connection.py):
# - Postgres (config abaixo): SEMPRE usado para o estado do próprio sistema
#   (usuários, trilha de auditoria de login, histórico de relatórios, layouts,
#   cores de categoria) — independente do valor de DB_BACKEND.
# - Oracle/Postgres (config ORACLE_* + DB_BACKEND abaixo): dado de
#   negócio/RAG financeiro (views do Protheus) — "oracle" em produção,
#   "postgres" localmente (contra views de teste), se não tiver acesso ao
#   Oracle real.
DB_BACKEND=oracle

# Conexão com o Oracle (dado de negócio/RAG financeiro)
ORACLE_DSN=host:porta/service_name
ORACLE_USER=seu_usuario
ORACLE_PASSWORD=sua_senha
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4
ORACLE_POOL_INCREMENT=1
# Só necessário se o servidor Oracle exigir Native Network Encryption/Data
# Integrity (thin mode não suporta) — caminho do Oracle Instant Client.
ORACLE_CLIENT_LIB_DIR=

# Login/auditoria de usuário do Protheus (tools/ti/protheus_login.py) —
# OPCIONAL, conexão separada e independente do ORACLE_DSN acima. Sem isso
# preenchido, a detecção de segurança do módulo TI (Segurança de TI) só não
# usa essa fonte a mais. Aponte pra homologação, nunca produção, sem ter
# certeza absoluta — usuário deve ter só SELECT nesse ambiente, nunca uma
# conta com permissão de escrita.
PROTHEUS_DSN=
PROTHEUS_USER=
PROTHEUS_PASSWORD=
PROTHEUS_SCHEMA=PROTHMG

# Conexão com o Postgres — SEMPRE usada (estado do sistema), e também usada
# como dado de negócio/RAG quando DB_BACKEND=postgres (teste local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agente_oracle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Servidor MCP
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Origens (frontend) autorizadas a chamar a API pelo navegador, separadas por
# vírgula. Adicione aqui o domínio de produção quando fizer o deploy.
ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Ollama (opcional)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Modelo de embeddings pro RAG de candidatos do RH — precisa ser baixado à
# parte: `ollama pull nomic-embed-text`.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Autenticação (login próprio do sistema)
# Chave usada pra assinar o token de login — gere um valor aleatório único
# (ex: python -c "import secrets; print(secrets.token_hex(32))") e nunca
# reutilize entre ambientes. Trocar essa chave desloga todo mundo na hora.
AUTH_SECRET_KEY=
AUTH_TOKEN_HORAS=8

# Integração real com o GLPI (service desk, tools/ti/glpi.py) — sem cliente
# mock. Sem GLPI_BASE_URL preenchida, o servidor ainda sobe normal (outros
# módulos não dependem disso), mas a funcionalidade de TI (Auditoria de
# Chamados, webhook) não funciona até isso ser configurado. Preenchendo, as
# 4 credenciais abaixo (client OAuth + usuário/senha de uma conta de
# serviço) viram obrigatórias — autenticação é
# grant `password`, não `client_credentials` puro (confirmado contra uma
# instância real: token de client_credentials sem usuário por trás é
# rejeitado em qualquer endpoint de recurso, ver docstring de
# tools/ti/glpi.py). GLPI_WEBHOOK_SECRET precisa de pelo menos 32
# caracteres (mesma regra do AUTH_SECRET_KEY acima — gere com o mesmo
# comando).
GLPI_BASE_URL=
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_WEBHOOK_SECRET=

# API Legada do GLPI (apirest.php) — OPCIONAL, autenticação por sessão
# (App-Token do cliente + token pessoal de usuário), mecanismo diferente do
# OAuth acima. Só é usada pra marcar o motivo de pendência "Aguardando
# usuário" (PendingReason_Item) quando um chamado fica incompleto — a API
# nova (v2.3) só lê essa informação, nunca escreve (confirmado no
# código-fonte do GLPI). Sem isso configurado, o chamado ainda é marcado
# "Pendente" (status genérico), só não ganha o motivo específico — ver
# tools/ti/glpi.py::ClienteGLPIReal._marcar_aguardando_usuario.
GLPI_LEGACY_API_URL=
GLPI_LEGACY_APP_TOKEN=
GLPI_LEGACY_USER_TOKEN=
